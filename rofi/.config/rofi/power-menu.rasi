/* ═══════════════════════════════════════════════════════════════════════════
   Rofi Power Menu — Alex Monochrome Theme
   2x2 grid: Lock · Sleep · Reboot · Shutdown
   ═══════════════════════════════════════════════════════════════════════════ */

configuration {
    show-icons:                 false;
    hover-select:               true;
    scroll-method:              0;
    me-select-entry:            "";
    me-accept-entry:            "MousePrimary";
    kb-row-left:                "";
    kb-row-right:               "";
}

@import "~/.config/theme/tokens.rasi"

window {
    width:                      28em;
    location:                   center;
    anchor:                     center;
    border:                     1px;
    border-color:               @border-module;
    background-color:           @bg-bar;
    border-radius:              @radius-lg;
}

mainbox {
    orientation:                vertical;
    children:                   [ "listbox" ];
    background-color:           transparent;
}

listbox {
    orientation:                vertical;
    children:                   [ "listview" ];
    background-color:           transparent;
}

listview {
    padding:                    10px;
    spacing:                    6px;
    lines:                      2;
    columns:                    2;
    cycle:                      false;
    dynamic:                    false;
    scrollbar:                  false;
    fixed-height:               true;
    expand:                     true;
    background-color:           transparent;
}

element {
    padding:                    18px 14px;
    margin:                     2px;
    border-radius:              @radius-md;
    border:                     none;
    expand:                     true;
}

element normal.normal,
element alternate.normal {
    background-color:           @bg-module;
    text-color:                 @fg-primary;
}

element normal.hover,
element alternate.hover {
    background-color:           @bg-hover;
    text-color:                 @fg-primary;
}

element selected.normal {
    background-color:           @overlay-active;
    text-color:                 @fg-primary;
}

element selected.hover {
    background-color:           @overlay-strong;
    text-color:                 @fg-primary;
}

element-text {
    horizontal-align:           0.5;
    vertical-align:             0.5;
    font:                       "JetBrainsMono Nerd Font 14";
}

error-message {
    children:                   [ "textbox" ];
    background-color:           @bg-tooltip;
}

textbox {
    vertical-align:             0.5;
    horizontal-align:           0.5;
    text-color:                 @fg-muted;
}
