{
    "hyprland/workspaces": {
        "format": "{id} {windows}",
        "format-window-separator": "",
        "sort-by": "id",
        "show-special": true,
        "special-visible-only": true,
        "workspace-taskbar": {
            "enable": true,
            "update-active-window": true,
            "format": "{icon}",
            "icon-size": 16,
            "on-click-window": "hyprctl dispatch focuswindow address:{address}"
        }
    },
    "clock": {
        "format": "{:%H:%M | %a | %d %b}",
        "tooltip": true,
        "tooltip-format": "{calendar}",
        "on-click": "xdg-open https://calendar.google.com && sleep 0.1 && hyprctl dispatch focuswindow class:firefox",
        "calendar": {
          "mode": "month",
          "weeks-pos": "right",
          "on-scroll": 1,
          "format": {
            "months": "<span color='#ffead3'><b>{}</b></span>",
            "days": "<span color='#ecc6d9'>{}</span>",
            "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
            "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
            "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
          }
        },
        "actions": {
          "on-scroll-up": "shift_down",
          "on-scroll-down": "shift_up"
        }
    },
    "custom/whisper": {
        "format": "{}",
        "return-type": "json",
        "interval": 1,
        "exec": "~/.config/hypr/scripts/whisper-status.sh",
        "on-click": "~/.config/hypr/scripts/whisper-toggle.sh",
        "on-click-right": "~/.config/hypr/scripts/whisper-backend-toggle.sh",
        "tooltip": true
    },
    "custom/weather": {
        "format": "{}",
        "tooltip": true,
        "escape": true,
        "interval": 1800,
        "exec": "~/.config/waybar/scripts/weather.sh",
        "return-type": "json",
        "on-click": "xdg-open https://www.bom.gov.au/location/australia/victoria/central/o2141206946-kensington && sleep 0.1 && hyprctl dispatch focuswindow class:firefox"
    },
    "bluetooth": {
        "format": "󰂯 {status}",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-on": "󰂯",
        "format-connected": "󰂱",
        "format-connected-battery": "󰂱 {device_battery_percentage}%",
        "tooltip-format": "󰂯 Bluetooth: {status}",
        "tooltip-format-connected": "󰂱 Connected Devices:\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "  • {device_alias}",
        "tooltip-format-enumerate-connected-battery": "  • {device_alias} 󰁹 {device_battery_percentage}%",
        "on-click": "blueman-manager",
        "interval": 5
    },
    "pulseaudio": {
        "format": "\uf028  {volume}%",
        "format-bluetooth": "\uf028  {volume}%",
        "format-muted": "\uf026  Muted",
        "scroll-step": 2,
        "smooth-scrolling-threshold": 3,
        "on-click": "pavucontrol",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "tooltip": true,
        "tooltip-format": "Volume: {volume}%\nSink: {desc}",
        "tooltip-format-muted": "Audio Muted"
    },
    "battery": {
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰂄 {capacity}%",
        "format-full": "󰁹 {capacity}%",
        "format-icons": [
            "󰂎",
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ],
        "interval": 30,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "tooltip": true,
        "tooltip-format": "{capacity}% · {timeTo}"
    },
    "network": {
        "format-wifi": "󰖩 {signalStrength}%",
        "format-ethernet": "󰈀 Connected",
        "format-disconnected": "󰖪 Disconnected",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}\nGateway: {gwaddr}\nUp: {bandwidthUpBits}\nDown: {bandwidthDownBits}",
        "tooltip-format-wifi": "{essid}\nQuality: {signalStrength}%\nIP: {ipaddr}/{cidr}\nFrequency: {frequency} GHz\nUp: {bandwidthUpBits}\nDown: {bandwidthDownBits}",
        "tooltip-format-disconnected": "Disconnected",
        "interval": 1
    },
    "group/hardware": {
        "orientation": "horizontal",
        "format": "󰍛",
        "drawer": {
            "transition-duration": 300,
            "transition-left-to-right": false
        },
        "modules": [
            "custom/system-icon",
            "bluetooth",
            "pulseaudio",
            "network"
        ]
    },
    "custom/system-icon": {
      "format": "\uf100",
      "tooltip": false
    },
    "custom/media-player": {
        "format": "{}",
        "return-type": "json",
        "max-length": 40,
        "min-length": 20,
        "escape": false,
        "exec": "~/.config/waybar/scripts/media-player.sh",
        "on-click": "playerctl play-pause -p spotify",
        "on-click-right": "playerctl play-pause -p firefox",
        "on-click-middle": "hyprctl dispatch togglespecialworkspace && hyprctl dispatch focuswindow title:Spotify",
        "interval": 1
    }
}
